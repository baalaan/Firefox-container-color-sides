{
  "manifest_version": 2,
  "version": "1.0",
  "name": "Container Clarity",
  "description": "A muted, minimal theme designed to pair with the Container Color userChrome.css tweaks. Provides subtle depth so container colors and the selected tab card stand out clearly.",
  "theme": {
    "colors": {
      "frame": "#1a1a2e",
      "tab_background_text": "#d4d4dc",
      "tab_selected": "#262640",
      "tab_line": "transparent",
      "tab_loading": "#7a7aff",
      "toolbar": "#22223a",
      "toolbar_text": "#d4d4dc",
      "toolbar_field": "#2a2a48",
      "toolbar_field_text": "#e8e8ee",
      "toolbar_field_border": "#3a3a58",
      "toolbar_field_focus": "#32325a",
      "toolbar_field_border_focus": "#5a5aaa",
      "toolbar_top_separator": "transparent",
      "toolbar_bottom_separator": "transparent",
      "toolbar_vertical_separator": "transparent",
      "icons": "#a0a0b8",
      "icons_attention": "#7a7aff",
      "popup": "#22223a",
      "popup_text": "#d4d4dc",
      "popup_border": "#3a3a58",
      "popup_highlight": "#3a3a68",
      "popup_highlight_text": "#ffffff",
      "sidebar": "#1e1e34",
      "sidebar_text": "#d4d4dc",
      "sidebar_border": "#2a2a48",
      "sidebar_highlight": "#3a3a68",
      "sidebar_highlight_text": "#ffffff",
      "ntp_background": "#16162a",
      "ntp_text": "#d4d4dc",
      "ntp_card_background": "#22223a",
      "button_background_hover": "#3a3a58",
      "button_background_active": "#4a4a6a"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#f4f2ef",
      "tab_background_text": "#2a2a35",
      "tab_selected": "#ffffff",
      "tab_line": "transparent",
      "tab_loading": "#5555cc",
      "toolbar": "#eae8e4",
      "toolbar_text": "#2a2a35",
      "toolbar_field": "#ffffff",
      "toolbar_field_text": "#1a1a25",
      "toolbar_field_border": "#d8d6d2",
      "toolbar_field_focus": "#ffffff",
      "toolbar_field_border_focus": "#5555cc",
      "toolbar_top_separator": "transparent",
      "toolbar_bottom_separator": "transparent",
      "toolbar_vertical_separator": "transparent",
      "icons": "#6a6a78",
      "icons_attention": "#5555cc",
      "popup": "#f4f2ef",
      "popup_text": "#2a2a35",
      "popup_border": "#d8d6d2",
      "popup_highlight": "#dddbd8",
      "popup_highlight_text": "#1a1a25",
      "sidebar": "#f0eee9",
      "sidebar_text": "#2a2a35",
      "sidebar_border": "#d8d6d2",
      "sidebar_highlight": "#dddbd8",
      "sidebar_highlight_text": "#1a1a25",
      "ntp_background": "#f8f6f3",
      "ntp_text": "#2a2a35",
      "ntp_card_background": "#ffffff",
      "button_background_hover": "#dddbd8",
      "button_background_active": "#cccac6"
    }
  }
}
